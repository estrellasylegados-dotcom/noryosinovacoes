# Copie este arquivo para .env.local e preencha conforme cada integração for
# sendo ativada. Nunca commite .env.local (já está no .gitignore do Next.js).

# --- Marca / configuração central ---
NEXT_PUBLIC_SITE_URL=https://noryosinovacoes.com.br
NEXT_PUBLIC_CONTACT_EMAIL=contato@noryosinovacoes.com.br

# WhatsApp comercial — formato E.164 sem símbolos, ex: 5511999999999.
# Enquanto vazio, os CTAs caem em fallback de e-mail (ver src/lib/config.ts).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Redes sociais (opcional, usado no footer/structured data quando preenchido)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# --- Supabase (Diagnóstico Digital: persistência + rate limit compartilhado) ---
# Criar projeto em https://supabase.com, rodar TODO o SQL de src/lib/supabase.ts
# (tabela diagnosticos + tabela/função diagnostico_check_rate_limit) e preencher
# as duas variáveis abaixo. SERVICE_ROLE fica só no servidor — nunca NEXT_PUBLIC_.
# Sem Supabase em produção, /api/diagnostico responde 503 controlado (não grava
# em disco). Ver DIAGNOSTIC_ALLOW_FILE_FALLBACK.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Libera o fallback de persistência em arquivo local (.data/…jsonl) mesmo com
# NODE_ENV=production. Use SÓ em ambiente de teste/homologação sem Supabase.
# Em produção real: deixe vazio (Supabase é obrigatório).
DIAGNOSTIC_ALLOW_FILE_FALLBACK=

# Overrides do rate limit (opcional). Default: 5 requisições / 600000 ms por IP.
DIAGNOSTIC_RATELIMIT_MAX=
DIAGNOSTIC_RATELIMIT_WINDOW_MS=

# --- Notificação por e-mail do Diagnóstico Digital ---
# Destinatário INTERNO da notificação de novo diagnóstico. Server-side —
# NUNCA prefixar com NEXT_PUBLIC_. O endpoint lê só desta variável; o
# visitante nunca escolhe o destinatário. Sem ela, o diagnóstico é salvo
# normalmente e o servidor registra um warning (nenhum e-mail é enviado).
# Produção (fase de teste): rafaviriato@hotmail.com
DIAGNOSTIC_NOTIFICATION_EMAIL=

# Provedor. "resend" (default) | "mock" (grava em .data/…jsonl, só dev/teste).
DIAGNOSTIC_EMAIL_PROVIDER=resend
# Secret — server-side. Criar conta em https://resend.com → API Keys.
RESEND_API_KEY=

# Remetente da notificação. Em produção, usar um endereço de um domínio
# verificado no Resend (ex: diagnostico@noryosinovacoes.com.br). Sem
# domínio verificado, o Resend só entrega a partir de onboarding@resend.dev.
DIAGNOSTIC_NOTIFICATION_FROM=

# --- Analytics (preencher quando as contas existirem) ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
