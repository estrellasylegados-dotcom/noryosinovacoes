# Copie este arquivo para .env.local e preencha conforme cada integração for
# sendo ativada. Nunca commite .env.local (já está no .gitignore do Next.js).

# --- Marca / configuração central ---
NEXT_PUBLIC_SITE_URL=https://noryosinovacoes.com.br
NEXT_PUBLIC_CONTACT_EMAIL=contato@noryosinovacoes.com.br

# WhatsApp comercial — formato E.164 sem símbolos, ex: 5511999999999.
# Enquanto vazio, os CTAs caem em fallback de e-mail (ver src/lib/config.ts).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Redes sociais (opcional, usado no footer/structured data quando preenchido)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# --- Supabase (Diagnóstico Digital) ---
# Criar projeto em https://supabase.com, rodar o SQL de src/lib/supabase.ts
# e preencher as duas variáveis abaixo. SERVICE_ROLE fica só no servidor —
# nunca prefixar com NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Analytics (preencher quando as contas existirem) ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
